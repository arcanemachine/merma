{
  "name": "merma",
  "version": "0.1.0",
  "description": "A live view of Mermaid diagram files in the browser, with point-and-click editing",
  "keywords": [
    "mermaid",
    "diagram",
    "live",
    "viewer"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "merma": "bin/merma.js"
  },
  "files": [
    "bin/",
    "server/",
    "web/",
    "docs/",
    "README.md",
    "LICENSE.md",
    "!web/tsconfig.json"
  ],
  "scripts": {
    "start": "node bin/merma.js serve",
    "test": "node --test 'test/*.test.mjs'",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "typecheck": "tsc -p web && tsc -p ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^7.0.2"
  }
}
