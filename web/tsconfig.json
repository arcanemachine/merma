// Type-checking only (`npm run typecheck`): the page, which runs in the browser. Its settings are the Node side's,
// but for the DOM and no Node types: "types" is empty so that Node's types, installed for the server, are not taken in
// here, since the page cannot use Node's APIs.
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": []
  },
  "include": [".", "../types"]
}
