// Type-checking only (`npm run typecheck`): the code runs as plain JavaScript, with no build step. This config is the
// Node side, the command line and the server; the page's, web/tsconfig.json, extends it.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // A catch variable is read as an Error throughout; narrowing each one would change what a thrown
    // non-Error prints, and an `any` annotation on each would check nothing.
    "useUnknownInCatchVariables": false,
    "module": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["server", "bin"]
}
